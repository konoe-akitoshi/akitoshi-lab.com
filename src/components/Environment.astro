---
// import { config } from '../settings/site-settings';

const networkStack = [
  { icon: 'i-mdi:router-network', label: 'Yamaha RTX1210' },
  { icon: 'i-clarity:network-switch-solid', label: 'Dell S6010-on' },
];

const servers = [
  { name: 'HPE DL360 gen8' },
  { name: 'Dell R620' },
  { name: 'Dell R720xd' },
];

const computeEnv = [
  { label: 'サーバー', value: 'Ubuntu Server / Nginx (reverse proxy)' },
  { label: 'このサイト', value: 'Astro + UnoCSS（静的配信）' },
  { label: 'ブログ', value: 'Nuxt3 + Node.js + microCMS' },
];
---

<section class="mb-10">
    <h2 class="text-3xl mb-4"><i class="i-material-symbols-light-shield-with-house-outline-rounded"></i> 自宅環境</h2>
    <hr class="border-gray-400 mb-4" />

    <h3 class="text-xl mb-2">物理環境</h3>
    <div class="max-w-[800px] mx-auto bg-white p-6 lg:p-8 rounded-lg shadow-lg">
        <div class="flex flex-col items-center mb-6 lg:mb-8">
            {networkStack.map((device) => (
                <div class="flex flex-col items-center mb-6 lg:mb-8">
                    <div class="flex items-center mb-2 bg-gray-100 p-3 lg:p-4 rounded-lg shadow">
                        <div class={`${device.icon} w-8 h-8 lg:w-10 lg:h-10 text-gray-800 mr-2`}></div>
                        <p class="text-black text-base lg:text-lg">{device.label}</p>
                    </div>
                    <div class="h-6 lg:h-8 w-1 bg-gray-400"></div>
                </div>
            ))}

            <!-- Servers Box -->
            <div class="flex flex-col items-center w-full">
                <div class="bg-gray-100 p-4 lg:p-6 rounded-lg shadow inline-block">
                    <div class="flex flex-wrap justify-center lg:justify-start items-start">
                        {servers.map((server) => (
                            <div class="bg-white p-4 rounded-lg shadow flex flex-col items-center mx-2 lg:mx-4 mb-4 lg:mb-0">
                                <div class="bg-gray-200 p-3 lg:p-4 rounded-lg shadow flex flex-col items-center mb-2 lg:mb-4">
                                    <div class="i-mdi:server-outline w-6 h-6 lg:w-8 lg:h-8 text-gray-800 mb-2"></div>
                                    <p class="text-black text-sm lg:text-base text-center">{server.name}</p>
                                </div>
                                <div class="flex flex-wrap justify-center">
                                    <div class="bg-orange-100 p-2 rounded-lg shadow mx-1 lg:mx-2 mb-2 lg:mb-0">
                                        <div class="i-mdi:ubuntu w-4 h-4 lg:w-6 lg:h-6 text-orange-600"></div>
                                    </div>
                                    <div class="bg-orange-100 p-2 rounded-lg shadow mx-1 lg:mx-2 mb-2 lg:mb-0">
                                        <div class="i-mdi:ubuntu w-4 h-4 lg:w-6 lg:h-6 text-orange-600"></div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h3 class="text-xl mb-2 mt-8">計算環境</h3>
    <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        {computeEnv.map((row) => (
            <>
                <dt class="text-gray-500">{row.label}</dt>
                <dd>{row.value}</dd>
            </>
        ))}
    </dl>
</section>
